# PostgreSQL Database Connection URL (e.g., Supabase, Neon, Railway, local PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JSON Web Token Secret for Admin Authentication
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Initial Admin Credentials (used during prisma db seed or first boot)
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# Cloudinary Image Storage Provider Credentials
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
