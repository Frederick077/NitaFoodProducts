# PostgreSQL Database Connection URL (e.g., Supabase, Neon, Railway, local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# JSON Web Token Secret for Admin Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key"

# Initial Admin Credentials (used during prisma db seed or first boot)
ADMIN_INITIAL_EMAIL="admin@nitafoods.local"
ADMIN_INITIAL_PASSWORD="change-this-before-production"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Cloudinary Image Storage Provider Credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
